
class Solution {
public:
    ListNode *getIntersectionNode(
        ListNode *headA, ListNode *headB) {

        unordered_set<ListNode*> visited;

        while (headA != NULL) {
            visited.insert(headA);
            headA = headA->next;
        }

        while (headB != NULL) {

            if (visited.count(headB)) {
                return headB;
            }

            headB = headB->next;
        }

        return NULL;
    }
};
