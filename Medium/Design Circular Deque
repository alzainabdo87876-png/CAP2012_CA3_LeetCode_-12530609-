
class MyCircularDeque {
public:

    vector<int> arr;
    int front;
    int rear;
    int size;
    int capacity;

    MyCircularDeque(int k) {

        arr.resize(k);

        front = 0;
        rear = -1;
        size = 0;
        capacity = k;
    }

    bool insertFront(int value) {

        if (isFull()) return false;

        front = (front - 1 + capacity) % capacity;

        arr[front] = value;

        if (size == 0)
            rear = front;

        size++;

        return true;
    }

    bool insertLast(int value) {

        if (isFull()) return false;

        rear = (rear + 1) % capacity;

        arr[rear] = value;

        if (size == 0)
            front = rear;

        size++;

        return true;
    }

    bool deleteFront() {

        if (isEmpty()) return false;

        front = (front + 1) % capacity;

        size--;

        return true;
    }

    bool deleteLast() {

        if (isEmpty()) return false;

        rear = (rear - 1 + capacity) % capacity;

        size--;

        return true;
    }

    int getFront() {
        return isEmpty() ? -1 : arr[front];
    }

    int getRear() {
        return isEmpty() ? -1 : arr[rear];
    }

    bool isEmpty() {
        return size == 0;
    }

    bool isFull() {
        return size == capacity;
    }
};
