
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {

        ListNode* dummy = new ListNode(0);
        dummy->next = head;

        int count = 0;
        ListNode* current = head;

        while (current != NULL) {
            count++;
            current = current->next;
        }

        current = dummy;

        for (int i = 0; i < count - n; i++) {
            current = current->next;
        }

        current->next = current->next->next;

        return dummy->next;
    }
};
