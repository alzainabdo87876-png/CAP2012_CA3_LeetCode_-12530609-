
class Solution {
public:
    double findMedianSortedArrays(
        vector<int>& nums1,
        vector<int>& nums2) {

        vector<int> arr;

        for (int x : nums1) {
            arr.push_back(x);
        }

        for (int x : nums2) {
            arr.push_back(x);
        }

        sort(arr.begin(), arr.end());

        int mid = arr.size() / 2;

        if (arr.size() % 2 == 0) {

            return (arr[mid - 1] + (double)arr[mid]) / 2.0;
        }

        return arr[mid];
    }
};
